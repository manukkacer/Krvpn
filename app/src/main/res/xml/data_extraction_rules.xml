<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="krvpn_security.xml" />
        <exclude
            domain="sharedpref"
            path="krvpn_configs.xml" />
        <exclude
            domain="file"
            path="configs" />
        <exclude
            domain="database"
            path="krvpn_datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="krvpn_security.xml" />
        <exclude
            domain="sharedpref"
            path="krvpn_configs.xml" />
        <exclude
            domain="file"
            path="configs" />
    </device-transfer>
</data-extraction-rules>
