<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== BASE THEME (Light) ===== -->
    <style name="Theme.KRVPN" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/krvpn_primary</item>
        <item name="colorPrimaryVariant">@color/krvpn_primary_variant</item>
        <item name="colorPrimaryContainer">@color/krvpn_primary_light</item>
        <item name="colorOnPrimary">@color/krvpn_on_primary</item>
        <item name="colorOnPrimaryContainer">@color/krvpn_on_primary</item>

        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/krvpn_secondary</item>
        <item name="colorSecondaryVariant">@color/krvpn_secondary_variant</item>
        <item name="colorSecondaryContainer">@color/krvpn_secondary_light</item>
        <item name="colorOnSecondary">@color/krvpn_on_secondary</item>
        <item name="colorOnSecondaryContainer">@color/krvpn_on_secondary</item>

        <!-- Tertiary Brand Colors -->
        <item name="colorTertiary">@color/krvpn_tertiary</item>
        <item name="colorTertiaryVariant">@color/krvpn_tertiary_variant</item>
        <item name="colorTertiaryContainer">@color/krvpn_warning_light</item>
        <item name="colorOnTertiary">@color/krvpn_on_tertiary</item>
        <item name="colorOnTertiaryContainer">@color/krvpn_on_tertiary</item>

        <!-- Surface Colors -->
        <item name="colorSurface">@color/krvpn_surface</item>
        <item name="colorSurfaceVariant">@color/krvpn_surface_variant</item>
        <item name="colorSurfaceContainer">@color/krvpn_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/krvpn_surface_container_high</item>
        <item name="colorOnSurface">@color/krvpn_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/krvpn_on_surface_variant</item>

        <!-- Background Colors -->
        <item name="colorBackground">@color/krvpn_background</item>
        <item name="colorOnBackground">@color/krvpn_on_background</item>

        <!-- Error Colors -->
        <item name="colorError">@color/krvpn_error</item>
        <item name="colorErrorContainer">@color/krvpn_error_container</item>
        <item name="colorOnError">@color/krvpn_on_error</item>
        <item name="colorOnErrorContainer">@color/krvpn_on_error</item>

        <!-- Outline -->
        <item name="colorOutline">@color/krvpn_outline</item>
        <item name="colorOutlineVariant">@color/krvpn_outline_variant</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/krvpn_primary</item>
        <item name="android:navigationBarColor">@color/krvpn_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/krvpn_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Ripple -->
        <item name="colorControlHighlight">@color/krvpn_primary_light</item>

        <!-- Text Appearance -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.KRVPN.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.KRVPN.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.KRVPN.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.KRVPN.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.KRVPN.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.KRVPN.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.KRVPN.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.KRVPN.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.KRVPN.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.KRVPN.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.KRVPN.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.KRVPN.LabelSmall</item>
    </style>

    <!-- ===== DARK THEME OVERRIDES ===== -->
    <style name="Theme.KRVPN.Dark" parent="Theme.KRVPN">
        <item name="colorPrimary">@color/krvpn_primary_light</item>
        <item name="colorPrimaryVariant">@color/krvpn_primary</item>
        <item name="colorPrimaryContainer">@color/krvpn_primary_dark</item>

        <item name="colorSecondary">@color/krvpn_secondary_light</item>
        <item name="colorSecondaryVariant">@color/krvpn_secondary</item>
        <item name="colorSecondaryContainer">@color/krvpn_secondary_variant</item>

        <item name="colorSurface">@color/krvpn_surface_dark</item>
        <item name="colorSurfaceVariant">@color/krvpn_surface_variant_dark</item>
        <item name="colorSurfaceContainer">@color/krvpn_surface_container_dark</item>
        <item name="colorOnSurface">@color/krvpn_on_surface_dark</item>

        <item name="colorBackground">@color/krvpn_background_dark</item>
        <item name="colorOnBackground">@color/krvpn_on_background_dark</item>

        <item name="android:statusBarColor">@color/krvpn_surface_dark</item>
        <item name="android:navigationBarColor">@color/krvpn_surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowBackground">@color/krvpn_background_dark</item>
    </style>

    <!-- ===== SPLASH THEME ===== -->
    <style name="Theme.KRVPN.Splash" parent="Theme.KRVPN">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- ===== DIALOG THEME ===== -->
    <style name="Theme.KRVPN.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="colorPrimary">@color/krvpn_primary</item>
        <item name="colorSurface">@color/krvpn_surface</item>
        <item name="colorOnSurface">@color/krvpn_on_surface</item>
    </style>

    <style name="Theme.KRVPN.BottomSheetDialog" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="colorSurface">@color/krvpn_surface</item>
        <item name="colorOnSurface">@color/krvpn_on_surface</item>
        <item name="bottomSheetStyle">@style/Widget.KRVPN.BottomSheet.Modal</item>
    </style>

    <!-- ===== CUSTOM TEXT APPEARANCES ===== -->
    <style name="TextAppearance.KRVPN.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/krvpn_font_medium</item>
        <item name="android:textColor">@color/krvpn_on_background</item>
    </style>

    <style name="TextAppearance.KRVPN.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/krvpn_font_medium</item>
        <item name="android:textColor">@color/krvpn_on_background</item>
    </style>

    <style name="TextAppearance.KRVPN.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/krvpn_font_medium</item>
        <item name="android:textColor">@color/krvpn_on_background</item>
    </style>

    <style name="TextAppearance.KRVPN.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/krvpn_font_semibold</item>
        <item name="android:textColor">@color/krvpn_on_surface</item>
    </style>

    <style name="TextAppearance.KRVPN.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/krvpn_font_medium</item>
        <item name="android:textColor">@color/krvpn_on_surface</item>
    </style>

    <style name="TextAppearance.KRVPN.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/krvpn_font_medium</item>
        <item name="android:textColor">@color/krvpn_on_surface</item>
    </style>

    <style name="TextAppearance.KRVPN.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/krvpn_font_regular</item>
        <item name="android:textColor">@color/krvpn_on_surface</item>
    </style>

    <style name="TextAppearance.KRVPN.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/krvpn_font_regular</item>
        <item name="android:textColor">@color/krvpn_on_surface_variant</item>
    </style>

    <style name="TextAppearance.KRVPN.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/krvpn_font_regular</item>
        <item name="android:textColor">@color/krvpn_on_surface_variant</item>
    </style>

    <style name="TextAppearance.KRVPN.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/krvpn_font_semibold</item>
        <item name="android:textColor">@color/krvpn_on_surface</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.KRVPN.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/krvpn_font_medium</item>
        <item name="android:textColor">@color/krvpn_on_surface</item>
    </style>

    <style name="TextAppearance.KRVPN.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/krvpn_font_regular</item>
        <item name="android:textColor">@color/krvpn_on_surface_variant</item>
    </style>

    <!-- ===== CUSTOM COMPONENT STYLES ===== -->
    <style name="Widget.KRVPN.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/krvpn_primary</item>
        <item name="textAppearance">@style/TextAppearance.KRVPN.LabelLarge</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.KRVPN.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/krvpn_primary</item>
        <item name="textAppearance">@style/TextAppearance.KRVPN.LabelLarge</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.KRVPN.Button.Tertiary" parent="Widget.Material3.Button.TextButton">
        <item name="textAppearance">@style/TextAppearance.KRVPN.LabelLarge</item>
    </style>

    <style name="Widget.KRVPN.Button.Danger" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/krvpn_error</item>
        <item name="textAppearance">@style/TextAppearance.KRVPN.LabelLarge</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.KRVPN.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/krvpn_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxStrokeColorFocused">@color/krvpn_primary</item>
        <item name="hintTextColor">@color/krvpn_on_surface_variant</item>
        <item name="placeholderTextColor">@color/krvpn_on_surface_variant</item>
    </style>

    <style name="Widget.KRVPN.Chip" parent="Widget.Material3.Chip.Entry">
        <item name="chipBackgroundColor">@color/krvpn_surface_variant</item>
        <item name="textAppearance">@style/TextAppearance.KRVPN.LabelMedium</item>
        <item name="chipCornerRadius">8dp</item>
    </style>

    <style name="Widget.KRVPN.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/krvpn_surface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/krvpn_outline_variant</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.KRVPN.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.KRVPN.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.KRVPN.BottomSheet" parent="ShapeAppearance.Material3.CornerSize.TopCorner">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
    </style>

    <!-- ===== TOOLBAR ===== -->
    <style name="Widget.KRVPN.Toolbar" parent="Widget.Material3.Toolbar.Primary">
        <item name="titleTextAppearance">@style/TextAppearance.KRVPN.TitleMedium</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.KRVPN.BodySmall</item>
    </style>
</resources>
